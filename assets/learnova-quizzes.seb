<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>originatorVersion</key><string>Learnova</string>
	<key>startURL</key><string>https://biosciencevista.com/quizzes/</string>
	<key>sendBrowserExamKey</key><false/>
	<key>allowQuit</key><true/>
	<key>quitURL</key><string>https://biosciencevista.com/?seb=quit</string>
	<key>quitURLConfirm</key><true/>
	<key>browserViewMode</key><integer>1</integer>
	<key>enableBrowserWindowToolbar</key><true/>
	<key>browserWindowAllowReload</key><true/>
	<key>newBrowserWindowByLinkPolicy</key><integer>1</integer>
	<key>newBrowserWindowByScriptPolicy</key><integer>1</integer>
	<key>allowDownUploads</key><false/>
	<key>allowPreferencesWindow</key><false/>
	<key>allowSpellCheck</key><false/>
	<key>enableZoomPage</key><true/>
	<key>enableZoomText</key><true/>
	<key>allowedDisplaysMaxNumber</key><integer>1</integer>
	<key>allowScreenSharing</key><false/>
	<key>enablePrintScreen</key><false/>
	<key>URLFilterEnable</key><false/>
</dict>
</plist>
